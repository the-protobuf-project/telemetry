      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Labels printed",
      "description": "Labels shipping-cpp printed: its shipping.label spans.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_calls_total{service_name=\"shipping-cpp\", span_name=\"shipping.label\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Notifications sent",
      "description": "Confirmations notify-ts sent: its notify.send spans.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_calls_total{service_name=\"notify-ts\", span_name=\"notify.send\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Failed spans",
      "description": "Spans any of the services ended with an error status.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_calls_total{status_code=\"STATUS_CODE_ERROR\", service_name=~\"$service\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Recent checkouts",
      "description": "Each row is one checkout: one trace across all five services. Click a trace id to show it below.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"orders-go\" && name=\"checkout\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this checkout",
                    "url": "/d/telemetry-journey/distributed-journey?var-trace=${__value.raw}&${__url_time_range}&${service:queryparam}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "nodeGraph",
      "title": "Service map",
      "description": "Who called whom, from the spans' client and server pairs (Tempo service graphs).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "row",
      "title": "Trace",
      "collapsed": false,
      "panels": [],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "traces",
      "title": "Trace ${trace}",
      "description": "The selected checkout's spans, every service and step. Pick one in Recent checkouts.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceId",
          "query": "${trace}"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 16
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "logs",
      "title": "Logs from every service",
      "description": "Distributed logging: each line carries the trace and span id it was written under. With a trace selected, only its logs; open a line's TraceID link to jump to its trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$service\"} | trace_id=~\"${trace}.*\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 11
      }
    },
    {
      "type": "row",
      "title": "Metrics",
      "collapsed": false,
      "panels": [],
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Step duration, p95",
      "description": "How long each step of the journey takes: cart.load, inventory.lookup, billing.charge and the rest (span metrics).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name, span_name) (rate(traces_duration_milliseconds_bucket{service_name=~\"$service\", span_kind=\"SPAN_KIND_INTERNAL\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} {{span_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second, by service",
      "description": "Requests each service answered (span metrics, so every language counts the same way).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(traces_calls_total{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "id": 17,
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Request duration, p95, by service",
      "description": "Each service's request time, the services after it included.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_duration_milliseconds_bucket{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Money",
      "description": "Average order value, payment and shipping quote, from each service's histogram.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(orders_go_order_value_sum[$__rate_interval])) / sum(rate(orders_go_order_value_count[$__rate_interval]))",
          "legendFormat": "order value (orders-go)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(payment_amount_sum[$__rate_interval])) / sum(rate(payment_amount_count[$__rate_interval]))",
          "legendFormat": "payment (billing-py)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(shipping_quote_sum[$__rate_interval])) / sum(rate(shipping_quote_count[$__rate_interval]))",
          "legendFormat": "shipping quote (shipping-cpp)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "id": 19,
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 9
      }
    }
  ]
}
