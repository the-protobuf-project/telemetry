"""
Bazel Project for Telemetry Cpp SDK
"""

module(
    name = "telemetry.cpp",
    version = "1.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)
bazel_dep(name = "gazelle_cc", version = "0.6.0", dev_dependency = True)

bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "curl", version = "8.22.0")
bazel_dep(name = "grpc", version = "1.84.0")
bazel_dep(name = "catch2", version = "3.15.1")
bazel_dep(name = "fmt", version = "12.2.0")
bazel_dep(name = "freertos", version = "11.1.0.bcr.3")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)
bazel_dep(name = "opentelemetry-cpp", version = "1.29.0")
bazel_dep(name = "spdlog", version = "1.17.0")
bazel_dep(name = "mcap", version = "2.1.3")

# grpc >= 1.80 (required by opentelemetry-cpp 1.29) still declares rules_swift
# 2.x, while Bazel 9's bazel_tools needs rules_swift 3.x. grpc only uses it for
# Apple Swift targets, so pin the newer line to resolve the compatibility level.
single_version_override(
    module_name = "rules_swift",
    version = "3.1.2",
)
