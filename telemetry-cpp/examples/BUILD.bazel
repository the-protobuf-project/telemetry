load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "main",
    srcs = ["main.cpp"],
    deps = ["//src:telemetry"],
)

cc_binary(
    name = "logging",
    srcs = ["logging.cpp"],
    deps = ["//src:telemetry"],
)

cc_binary(
    name = "logging_mcap",
    srcs = ["logging_mcap.cpp"],
    deps = ["//src:telemetry"],
)

cc_binary(
    name = "metrics",
    srcs = ["metrics.cpp"],
    deps = ["//src:telemetry"],
)

cc_binary(
    name = "tracing",
    srcs = ["tracing.cpp"],
    deps = ["//src:telemetry"],
)

cc_binary(
    name = "loadgen",
    srcs = ["loadgen.cpp"],
    deps = ["//src:telemetry"],
)

# The upstream OpenTelemetry C++ SDK alone, for comparison with loadgen.
cc_binary(
    name = "otel_baseline",
    srcs = ["otel_baseline.cpp"],
    deps = [
        "@opentelemetry-cpp//exporters/otlp:otlp_http_exporter",
        "@opentelemetry-cpp//exporters/otlp:otlp_http_log_record_exporter",
        "@opentelemetry-cpp//exporters/otlp:otlp_http_metric_exporter",
        "@opentelemetry-cpp//sdk/src/logs",
        "@opentelemetry-cpp//sdk/src/metrics",
        "@opentelemetry-cpp//sdk/src/trace",
    ],
)

cc_binary(
    name = "crosslang",
    srcs = ["crosslang.cpp"],
    deps = [
        "//src:telemetry",
        "@cpp-httplib//:httplib",
        "@nlohmann_json//:json",
    ],
)
