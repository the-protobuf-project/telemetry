load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "tracing",
    srcs = ["tracer.cpp"],
    implementation_deps = [
        "//include/telemetry/mcap",
        "//include/telemetry/otel",
        "//include/telemetry/tracing",
        "@opentelemetry-cpp//api",
    ],
    # The implementations, not only their headers: tracer.cpp calls into both,
    # and GNU ld resolves static archives in dependency order — a binary that
    # uses the tracer alone (examples:crosslang) otherwise fails to link.
    deps = [
        "//src/mcap",
        "//src/otel",
    ],
    strip_include_prefix = "/include",
    visibility = ["//visibility:public"],
)
