{
  "name": "@the-protobuf-project/telemetry",
  "version": "1.3.3",
  "description": "Unified observability for Node.js and the browser: logs, metrics, traces, profiles and MCAP recording over OpenTelemetry",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-protobuf-project/telemetry.git",
    "directory": "telemetry-ts"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "default": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      }
    },
    "./node": {
      "types": "./dist/index.node.d.ts",
      "default": "./dist/index.node.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "default": "./dist/index.browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "check:browser": "node scripts/check-browser.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@mcap/core": "2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.301.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@pyroscope/nodejs": ">=0.7.1"
  },
  "peerDependenciesMeta": {
    "@pyroscope/nodejs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
