{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@the-protobuf-project/telemetry": ["./src/index.node.ts"],
      "@the-protobuf-project/telemetry/node": ["./src/index.node.ts"],
      "@the-protobuf-project/telemetry/browser": ["./src/index.browser.ts"]
    }
  },
  "include": ["src", "test", "examples", "scripts"]
}
